{
  "manifest_version": 3,
  "name": "Image Size Checker Pro",
  "version": "3.4.0",
  "description": "Find heavy, oversized and distorted images on any page, then compress or resize them as drop-in replacements with the same filename.",
  "permissions": [
    "scripting",
    "storage",
    "downloads",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Image Size Checker Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-inspector": {
      "suggested_key": {
        "default": "Alt+Shift+I",
        "mac": "Alt+Shift+I"
      },
      "description": "Toggle on-page image inspector overlay"
    }
  },
  "side_panel": {
    "default_path": "popup.html?panel=1"
  },
  "minimum_chrome_version": "116"
}
